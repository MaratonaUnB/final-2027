---
interface Props {
  target: string;
  label?: string;
}

const { target, label } = Astro.props;

const units = [
  { key: 'days', label: 'dias' },
  { key: 'hours', label: 'horas' },
  { key: 'minutes', label: 'min' },
  { key: 'seconds', label: 'seg' },
];
---

<div
  class="countdown"
  data-countdown
  data-target={target}
  role="timer"
  aria-live="off"
  aria-label={label}
>
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
    {
      units.map((unit) => (
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-5 backdrop-blur-sm sm:px-6 sm:py-6">
          <div
            class="font-mono text-4xl font-semibold tabular-nums tracking-tight text-brand-fg sm:text-5xl lg:text-6xl"
            data-unit={unit.key}
          >
            --
          </div>
          <div class="mt-2 text-[0.7rem] font-medium uppercase tracking-[0.18em] text-brand-muted">
            {unit.label}
          </div>
        </div>
      ))
    }
  </div>
  <p class="sr-only" data-countdown-announce></p>
</div>

<script>
  const pad = (value: number) => String(value).padStart(2, '0');

  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((root) => {
    const target = new Date(root.dataset.target!).getTime();
    const fields = {
      days: root.querySelector<HTMLElement>('[data-unit="days"]')!,
      hours: root.querySelector<HTMLElement>('[data-unit="hours"]')!,
      minutes: root.querySelector<HTMLElement>('[data-unit="minutes"]')!,
      seconds: root.querySelector<HTMLElement>('[data-unit="seconds"]')!,
    };
    const announce = root.querySelector<HTMLElement>('[data-countdown-announce]')!;

    const tick = () => {
      const remaining = Math.max(target - Date.now(), 0);
      const totalSeconds = Math.floor(remaining / 1000);

      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      fields.days.textContent = String(days);
      fields.hours.textContent = pad(hours);
      fields.minutes.textContent = pad(minutes);
      fields.seconds.textContent = pad(seconds);
      announce.textContent = `Faltam ${days} dias para o evento.`;

      if (remaining === 0) clearInterval(timer);
    };

    tick();
    const timer = setInterval(tick, 1000);
  });
</script>
